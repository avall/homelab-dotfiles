#!/bin/bash

# by default, tile all windows
yabai -m config layout bsp

# New window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# padding
yabai -m config top_padding 5
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 5

# mouse settings
yabai -m config mouse_follows_focus on

yabai -m config mouse_modifier ctrl
# set modifier + left-click drag to move window (default: move)
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window (default: resize)
yabai -m config mouse_action2 resize

yabai -m config mouse_drop_action swap

# Priorizar splits verticales para maximizar alturas
yabai -m config split_type vertical

# Desactivar auto-balance para preservar alturas manuales
yabai -m config auto_balance on

# Ratio de split conservador (nuevo ventana toma ~60% width)
yabai -m config split_ratio 0.6


yabai -m rule --add app="^Screen Sharing$" sub-layer=above manage=off
yabai -m rule --add app="^System Settings$" sub-layer=above manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Hammerspoon$" manage=off
yabai -m rule --add app="^Alacritty$" manage=off
yabai -m rule --add app="^Thaw$" manage=off
yabai -m rule --add app="^Stickies$" manage=off

# apply rules to windows that already exist when the service starts
yabai -m rule --apply

# yabai -m config external_bar all:32:0
options=(
	style=round
	width=6.0
	hidpi=off
	active_color=0xffff9300
	inactive_color=0xff414550
	# Alacritty draws its own border, half this width, from
	# home/hammerspoon/init.lua. It has to be excluded here because `width` is a
	# global setting: `man borders` (1.9.0) lists blacklist and whitelist as the
	# only per-application options, and a second instance is not a way around it
	# either -- "if an instance of borders is already running, subsequent
	# invocations will update the existing process". Without this line Alacritty
	# would carry both borders at once.
	#
	# Lowercase, and that is not a typo. The list is matched against the process
	# name, not the application name: src/windows.c calls proc_name(pid, ...) and
	# passes the result straight to app_allowed(). Alacritty.app runs an
	# executable called `alacritty`, which is what `ps -eo ucomm=` reports, so
	# "Alacritty" silently matches nothing at all.
	blacklist="alacritty"
)

borders "${options[@]}"