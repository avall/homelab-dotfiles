# Floating rules, one per `yabai -m rule --add ... manage=off` in the yabairc this
# replaces. Matched by bundle identifier where the app is installed and the id
# could be read from its Info.plist; by name where it could not, which is also how
# yabai matched all of them.
#
# Alacritty is not on this list for the same reason as the others. Hammerspoon
# sets its frame directly (home/hammerspoon/init.lua, resizeWindow), so a tiling
# engine that also owns that window fights it on every ALT+D.

[[appRules]]
bundleId = "com.apple.ScreenSharing"
layout = "float"

[[appRules]]
bundleId = "com.apple.systempreferences"
layout = "float"

[[appRules]]
bundleId = "com.apple.calculator"
layout = "float"

[[appRules]]
appNameSubstring = "Karabiner-Elements"
layout = "float"

[[appRules]]
bundleId = "org.hammerspoon.Hammerspoon"
layout = "float"

[[appRules]]
bundleId = "org.alacritty"
layout = "float"

[[appRules]]
bundleId = "com.stonerl.Thaw"
layout = "float"

[[appRules]]
bundleId = "com.apple.Stickies"
layout = "float"
