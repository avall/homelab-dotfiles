// niri configuration — the counterpart to home/hyprland/hyprland.conf.
//
// This file fully REPLACES niri's built-in defaults; niri does not merge the
// two. Anything not declared here does not exist, which is why bindings the
// Hyprland config never needed (screenshots, quit) are spelled out below.
//
// Kept deliberately close to hyprland.conf so both compositors behave the
// same. Where niri has no equivalent, there is a comment saying so rather
// than a silent omission.

// ---- Input ------------------------------------------------------------------
input {
    keyboard {
        xkb {}
    }

    // hyprland.conf: follow_mouse = 1
    focus-follows-mouse

    touchpad {
        tap
        natural-scroll
    }

    mouse {}
}

// ---- Layout -----------------------------------------------------------------
// niri is a scrollable-tiling compositor, so Hyprland's dwindle layout and its
// pseudotile / togglesplit bindings have no counterpart. Column width is the
// nearest thing to split_ratio.
layout {
    gaps 5

    // Border on, focus ring off — matches Hyprland's single-border look.
    // Colors are hyprland.conf's col.active_border / col.inactive_border.
    focus-ring {
        off
    }

    border {
        width 5
        active-color "#ff9300"
        inactive-color "#414550"
    }

    // hyprland.conf: dwindle split_ratio = 0.6
    default-column-width { proportion 0.6; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// ---- Workspaces --------------------------------------------------------------
// Declared by name on purpose. niri places named workspaces first in the
// strip, so a lone `workspace "quake"` would take index 1 and steal Mod+1.
// Naming all of them makes the bindings below reference names instead of
// indices, so the order stops mattering.
workspace "quake"
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10"

// ---- Autostart ---------------------------------------------------------------
spawn-at-startup "waybar"

// Hyprland uses hyprpaper here. niri's manifest ships swaybg instead, and
// swaybg needs an explicit image or color, so this sets the inactive-border
// grey rather than leaving the background undefined.
spawn-at-startup "swaybg" "-c" "#414550"

spawn-at-startup "gammastep" "-O" "4000"

// Mirrors hyprland.conf. Note that cliphist on its own only stores what is
// piped to it — the usual `wl-paste --watch cliphist store` wiring is missing
// on both compositors, so clipboard history is inert until that is added.
spawn-at-startup "cliphist"

// The quake terminal, pre-spawned so the shell session outlives every toggle.
// --class sets the Wayland app_id that the window rule below matches.
spawn-at-startup "alacritty" "--class" "quake-alacritty"

// ---- Window rules ------------------------------------------------------------
// hyprland.conf: decoration rounding = 10
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// hyprland.conf: windowrule = float, ...
window-rule {
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^org\.kde\.kdiff3$"#
    match app-id=r#"^zoom$"#
    open-floating true
}

// The quake terminal. Hyprland pins it to 100% x 50% of the output; the niri
// equivalent is a full-width column, since a named workspace fills the screen
// either way.
window-rule {
    match app-id=r#"^quake-alacritty$"#
    open-on-workspace "quake"
    open-maximized true
}

// ---- Bindings ----------------------------------------------------------------
// "Mod" is Super on a TTY session, matching $mod = SUPER in hyprland.conf.
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Quake terminal — Alt+D / Alt+A, same pair as Hammerspoon and Hyprland.
    // Absolute path, not a bare command: scripts/bin lands on PATH via
    // zsh/export.sh, and niri's spawn-sh runs under plain sh, which never
    // reads it.
    Alt+D repeat=false { spawn-sh "$HOME/.dotfiles/homelab-dotfiles/scripts/bin/niri-quake-toggle"; }
    Alt+A repeat=false { spawn-sh "$HOME/.dotfiles/homelab-dotfiles/scripts/bin/niri-quake-toggle"; }

    // Application launchers, mirroring hyprland.conf.
    Alt+E { spawn "wezterm"; }
    Alt+I { spawn "idea-ultimate"; }

    Ctrl+Super+A { spawn "alacritty"; }
    Ctrl+Super+C { spawn "code"; }
    Ctrl+Super+I { spawn "idea-ultimate"; }
    Ctrl+Super+B { spawn "google-chrome-stable"; }

    // App launcher — fuzzel is the niri manifest's equivalent of wofi.
    Mod+R { spawn "fuzzel"; }

    // Window management. Hyprland's pseudo (Mod+P) and togglesplit (Mod+J)
    // have no equivalent in a scrollable-tiling layout and are omitted.
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }

    // Move focus.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Move windows.
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Resize. Hyprland uses binde (repeating); niri repeats by default.
    Mod+Alt+Right { set-column-width "+50"; }
    Mod+Alt+Left  { set-column-width "-50"; }
    Mod+Alt+Up    { set-window-height "-50"; }
    Mod+Alt+Down  { set-window-height "+50"; }

    // Workspaces, by name — see the workspace block above for why.
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "10"; }

    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Shift+0 { move-column-to-workspace "10"; }

    Mod+O repeat=false { toggle-overview; }

    // Screenshots — hyprshot -m output / -m region in hyprland.conf.
    Print { screenshot-screen; }
    Shift+Print { screenshot; }

    // Session. Hyprland's config has no quit binding; niri needs one because
    // this file replaces the defaults that would have provided it.
    Mod+Shift+E { quit; }

    Super+Alt+L { spawn "swaylock"; }
}
