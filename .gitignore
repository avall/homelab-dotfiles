.idea/
.DS_Store

# Generated by install.sh: a symlink to keybindings-macos.toml or
# keybindings-linux.toml depending on the platform. Versioning it meant every
# Arch machine carried a permanent diff against the committed macOS path.
home/alacritty/keybindings.toml

# Generated by install.sh: on Linux a symlink to dank-theme.toml, on macOS an
# empty file. Same reason as above -- it would be a permanent cross-platform diff.
home/alacritty/platform-theme.toml

# Written by DankMaterialShell into ~/.config/alacritty, which is a symlink to
# this directory. Machine-local desktop theme, regenerated on every theme change.
home/alacritty/dank-theme.toml

# Backups alacritty and Claude Code's /terminal-setup drop next to the config.
home/alacritty/alacritty.toml.*.bak
home/alacritty/alacritty.toml.backup.*

# Steampipe runtime state. ~/.steampipe is a symlink to home/steampipe, so the
# daemon writes these straight into the repo. Only config/, sql/ and csv/ are ours.
home/steampipe/logs/
home/steampipe/plugins/
home/steampipe/internal/
